# Dual SO-102 udev 규칙 예시 — 팔 4개 + 카메라 3대 (docs/2.ports.md)
#
#   cp config/99-dual-so102.rules.example config/99-dual-so102.rules
#   nano config/99-dual-so102.rules        # REPLACE_* 를 실제 값으로
#   sudo install -m 0644 config/99-dual-so102.rules /etc/udev/rules.d/99-dual-so102.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# 그 컴퓨터에 꽂히는 장치 줄만 남겨도 된다.
# Pi 분리 구성: Pi = 팔로워 2 + 카메라 3, PC = 리더 2.

# 팔 4개 — 보드 USB serial 기준. 값 확인:
#   udevadm info --query=property --name=/dev/ttyACM0 | grep ID_SERIAL_SHORT
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_FOLLOWER_LEFT_SERIAL", SYMLINK+="so102_follower_left", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_FOLLOWER_RIGHT_SERIAL", SYMLINK+="so102_follower_right", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_LEADER_LEFT_SERIAL", SYMLINK+="so102_leader_left", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_LEADER_RIGHT_SERIAL", SYMLINK+="so102_leader_right", GROUP="dialout", MODE="0660"

# 카메라 3대 — serial 이 없는 USB 카메라라 꽂은 USB 위치(KERNELS) 기준이다.
# 카메라를 다른 USB 포트에 꽂으면 별칭이 다른 카메라를 가리킨다.
# 값 확인 (영상 노드마다): udevadm info --attribute-walk --name=/dev/video0 | grep -m1 'KERNELS=="[0-9]'
# 예 (Pi 4 키트 1호): 탑뷰 1-1.3:1.0, 왼쪽 손목 1-1.4.4:1.0, 오른쪽 손목 1-1.4.3:1.0
# ATTR{index}=="0" 은 카메라마다 생기는 두 노드 중 영상 노드만 고른다.
SUBSYSTEM=="video4linux", KERNELS=="REPLACE_CAM_TOP_KERNELS", ATTR{index}=="0", SYMLINK+="cam_top"
SUBSYSTEM=="video4linux", KERNELS=="REPLACE_CAM_LEFT_KERNELS", ATTR{index}=="0", SYMLINK+="cam_left"
SUBSYSTEM=="video4linux", KERNELS=="REPLACE_CAM_RIGHT_KERNELS", ATTR{index}=="0", SYMLINK+="cam_right"
